# Copy this file to ".dev.vars" (git-ignored) for local development with `npm run dev`.
# In production, set these in the Cloudflare Pages dashboard instead
# (Settings → Environment variables, marked as Secret).

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Generate a long random value, e.g. in PowerShell:
#   [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))
SESSION_SECRET=replace-with-a-long-random-string
